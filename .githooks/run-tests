#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if command -v cmd.exe >/dev/null 2>&1; then
    # Git Bash otherwise rewrites cmd.exe switches such as /d into POSIX paths.
    export MSYS2_ARG_CONV_EXCL='*'
    exec cmd.exe /d /c test.bat
fi

runner=${GOLDENS_WINDOWS_TEST_RUNNER:-}
if [ -z "$runner" ]; then
    if configured_runner=$(git config --local --get goldens.windowsTestRunner); then
        runner=$configured_runner
    fi
fi

if [ -n "$runner" ]; then
    case "$runner" in
        /*) ;;
        *) runner="$repo_root/$runner" ;;
    esac
    if [ ! -x "$runner" ]; then
        echo "Configured Goldens Windows test runner is not executable: $runner" >&2
        exit 1
    fi
    exec "$runner" "$repo_root"
fi

echo "Goldens tests require Windows or a locally configured Windows test runner." >&2
echo "Set GOLDENS_WINDOWS_TEST_RUNNER or git config --local goldens.windowsTestRunner." >&2
exit 1
